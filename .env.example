# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Values here are for running on your machine (make run-snapshot, alembic,
# pytest). docker-compose.yml overrides the container-specific ones.

# Anthropic API key for the runtime agent (Cohort C). Separate from any Fable credits.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string. localhost reaches the compose postgres service
# through its published port; the containers use the "postgres" hostname instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/options_agent

# Model the agent runs on (Cohort C). Not the Fable/Claude Code model.
RUNTIME_MODEL=claude-sonnet-5

# Data adapter: robinhood (live, read-only MCP), fake (deterministic synthetic
# data for tests and dry runs). See NOTES.md for why robinhood was chosen.
ADAPTER=robinhood

# Robinhood Trading MCP endpoint. Only src/gateway/adapters/ ever reads this;
# the agent never sees it (PRD.md section 7, CLAUDE.md rule 3).
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Path to the OAuth token file written by `make robinhood-auth`. This is a file
# path, never the token itself. The worker container mounts ./data at /data.
ROBINHOOD_TOKEN_PATH=data/robinhood_token.json
