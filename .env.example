# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Anthropic API key for the runtime agent (Cohort C). Separate from any Fable credits.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string. In Docker Compose this points at the postgres service;
# for local scripts outside Compose, point at localhost with the mapped port.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/options_agent

# Model the agent runs on (Cohort C). Not the Fable/Claude Code model.
RUNTIME_MODEL=claude-sonnet-5

# Data adapter: robinhood or yfinance. See NOTES.md for why robinhood was chosen.
ADAPTER=robinhood

# Robinhood Trading MCP endpoint (read-only functions only; see PRD.md section 7 and
# CLAUDE.md rule 3 - the agent never calls this directly, only src/gateway/ does).
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Path to the persisted OAuth token store for the Robinhood adapter (refresh_token +
# access_token), written only by src/gateway/adapters/robinhood.py. Never the raw
# token value itself - this is a file path.
ROBINHOOD_TOKEN_PATH=/data/robinhood_token.json
